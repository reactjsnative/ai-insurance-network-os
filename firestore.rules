rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Helpers ----
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'akarapol.pro798@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    // Privileged roles must never be granted by a non-admin.
    function isPrivilegedRole(data) {
      return data.role in ['admin', 'super_admin', 'regional_manager', 'center_manager', 'unit_manager'];
    }

    function isValidMember(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.memberCode is string && data.memberCode.size() <= 32 &&
             data.name is string && data.name.size() <= 100 &&
             data.positionId is string && data.positionId.size() <= 50 &&
             data.role is string && data.role.size() <= 50 &&
             data.status in ['active', 'inactive', 'probation'] &&
             data.personalFYC is number;
    }
    function isValidApplication(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.applicationNo is string && data.applicationNo.size() <= 32 &&
             data.status in ['pending_review', 'document_verified', 'exam_passed', 'approved', 'rejected'] &&
             data.firstName is string && data.firstName.size() <= 80 &&
             data.lastName is string && data.lastName.size() <= 80 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.email is string && data.email.size() <= 150;
    }
    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 50 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.action is string && data.action.size() <= 100 &&
             data.entityType is string && data.entityType.size() <= 50;
    }
    function isValidCompensationPlan(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 50 &&
             data.name is string && data.name.size() <= 150 &&
             data.status in ['active', 'draft', 'archived'];
    }

    // ---- Members ----
    // Reads stay public for the org-chart directory. Writes require a signed-in
    // user, and non-admins can never create/update a privileged role record.
    match /members/{memberId} {
      allow get, list: if true;
      allow create, update: if isValidId(memberId) && isValidMember(incoming()) && isSignedIn() && (isAdmin() || !isPrivilegedRole(incoming()));
      allow delete: if isValidId(memberId) && isAdmin();
    }

    // ---- Candidate Recruitment Applications ----
    match /applications/{applicationId} {
      allow get, list: if true;
      allow create, update: if isValidId(applicationId) && isValidApplication(incoming()) && isSignedIn();
      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // ---- Audit logs: append-only, signed-in ----
    match /auditLogs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming()) && isSignedIn();
      allow update, delete: if false;
    }

    // ---- Video library (cross-device sync) ----
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(videoId) && isSignedIn();
    }

    // ---- TikTok links (cross-device sync) ----
    match /tiktokLinks/{linkId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(linkId) && isSignedIn();
    }

    // ---- Compensation plans: admin-only writes ----
    match /compensationPlans/{planId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(planId) && isValidCompensationPlan(incoming()) && isAdmin();
    }

    // ---- Admins registry ----
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    // ---- Password-reset OTP codes: server (Admin SDK) only ----
    match /resetCodes/{codeId} {
      allow read, write: if false;
    }

    // ---- Test connection ----
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
