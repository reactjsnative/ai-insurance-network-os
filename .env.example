# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# External member storage (optional – app works without these)
# ============================================================

# --- Google Sheets (new-member backup) ---
# Service-account JSON as a SINGLE-LINE string (escape quotes).
# Create a service account in Google Cloud, share the sheet with its email,
# and put the spreadsheet id below.
GOOGLE_SHEET_ID="YOUR_SPREADSHEET_ID"
GOOGLE_SHEETS_CREDENTIALS_JSON="{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key\":\"...\",\"client_email\":\"...@....iam.gserviceaccount.com\",\"...\":\"...\"}"

# --- Vercel Database (new-member backup) ---
# Option A: Vercel Postgres – provide DATABASE_URL (libsql/postgres connection string)
DATABASE_URL="postgres://user:pass@host/db"
# Option B: Vercel KV – provide both (used only if DATABASE_URL is absent)
KV_REST_API_URL="https://your-kv.vercel-storage.com"
KV_REST_API_TOKEN="your-kv-token"

