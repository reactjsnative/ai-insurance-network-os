# GEMINI_API_KEY: Required for Gemini AI API calls (AI Coach / analysis).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for AI Image Generator (gpt-image-1).
# Optional – image generation shows a clear error if not set.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ============================================================
# Owner notifications (optional – Telegram + LINE)
# Used by /api/notify-member and /api/report.
# ============================================================
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
TELEGRAM_CHAT_ID="-1001234567890"
LINE_TOKEN="your-line-notify-token"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# External member storage (optional – app works without these)
# ============================================================

# --- Google Sheets (new-member backup) ---
# Service-account JSON as a SINGLE-LINE string (escape quotes).
# Create a service account in Google Cloud, share the sheet with its email,
# and put the spreadsheet id below.
GOOGLE_SHEET_ID="YOUR_SPREADSHEET_ID"
GOOGLE_SHEETS_CREDENTIALS_JSON="{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key\":\"...\",\"client_email\":\"...@....iam.gserviceaccount.com\",\"...\":\"...\"}"

# --- Vercel Database (new-member backup) ---
# Option A: Vercel Postgres – provide DATABASE_URL (libsql/postgres connection string)
DATABASE_URL="postgres://user:pass@host/db"
# Option B: Vercel KV – provide both (used only if DATABASE_URL is absent)
KV_REST_API_URL="https://your-kv.vercel-storage.com"
KV_REST_API_TOKEN="your-kv-token"

# ============================================================
# TikTok Login Kit (optional – real OAuth; mock login works without this)
# Create app at https://developers.tiktok.com → Login Kit → get Client Key/Secret
# Add redirect URI in TikTok portal: http://localhost:3000/api/tiktok/callback (dev)
# and https://YOUR_DOMAIN/api/tiktok/callback (prod)
# ============================================================
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/tiktok/callback"

# ============================================================
# GitHub OAuth (optional – real OAuth; mock login works without this)
# Create OAuth App at https://github.com/settings/developers → New OAuth App
# Callback: http://localhost:3000/api/github/callback (dev) and https://YOUR_DOMAIN/api/github/callback (prod)
# ============================================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/github/callback"

